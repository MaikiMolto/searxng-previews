# SearXNG Preview Service Configuration

# Server Port (default: 3000)
PORT=3000

# CORS Origins (default: * for all, or comma-separated list)
CORS_ORIGINS=*

# Cache TTL in hours (default: 24)
CACHE_TTL_HOURS=24

# Maximum cache size in MB (default: 500)
MAX_CACHE_SIZE_MB=500

# Rate limit per minute per IP (default: 30)
RATE_LIMIT_PER_MINUTE=30

# Block private/local IPs (default: true)
BLOCK_PRIVATE_IPS=true

# Screenshot timeout in ms (default: 10000)
SCREENSHOT_TIMEOUT=10000

# Default viewport width for screenshots (default: 1280)
DEFAULT_VIEWPORT_WIDTH=1280

# Default viewport height for screenshots (default: 960)
DEFAULT_VIEWPORT_HEIGHT=960

# Default thumbnail width (default: 240)
DEFAULT_THUMB_WIDTH=240
